{
  "name": "colophon-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm --recursive --parallel run test",
    "typecheck": "pnpm --recursive run typecheck",
    "build": "pnpm --filter \"./packages/*\" run build && pnpm --filter colophon-web run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "sync": "node scripts/sync-web-data.mjs",
    "guard": "node scripts/guard-no-fabrication.mjs",
    "probe": "node scripts/probe-compat.mjs",
    "lab": "node scripts/semantic-lab.mjs",
    "recover": "node scripts/recover-history.mjs",
    "break": "node scripts/break-campaign.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev": "pnpm --filter colophon-web run dev"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3",
    "@solana/web3.js": "^1.99.0"
  }
}